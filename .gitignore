# Git ignore rules for WaterWatch AI Machine Learning Pipeline

# Raw datasets and archive files
*.zip
*.tar
*.gz
*.rar
*.7z

# Ignore large raw and extracted data
data/raw/
data/extracted/
dataset/
*.csv
!reports/*.csv
!data/processed/*_sample.csv
!data/manifests/*.csv
!waterwatch_ai_nagpur_localities*.csv

# Keep directory structure with .gitkeep
!.gitkeep

# Model weights and artifacts
models/rainfall/*.joblib
!models/rainfall/synthetic_rainfall_model.joblib
models/rainfall/*.json
!models/rainfall/feature_schema.json
!models/rainfall/model_metadata.json
models/rainfall/*.pkl
models/image/*.pt
!models/image/best.pt
models/image/*.pth
!models/image/mobilenetv3_waterlogging_best.pth
models/image/*.onnx
models/image/*.engine
runs/
*.pt
!models/image/best.pt

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & notebooks
.pytest_cache/
.coverage
htmlcov/
*.cache
.ipynb_checkpoints

# Derived / intermediate processed dataset folders & backups
data/processed/classification_water_logging/
data/processed/verified_negatives/
data/processed/*_backup/
data/processed/yolo_water_logging_pre_merge_backup/

# Additional model weights
models/image/*.pth
*.pth
!models/image/mobilenetv3_waterlogging_best.pth

# Temporary user uploads
waterwatch_integration/data/uploads/*
!waterwatch_integration/data/uploads/.gitkeep
!waterwatch_integration/data/uploads/detect_0ccad5ff89.jpg
!waterwatch_integration/data/uploads/detect_60b158455a.jpg
!waterwatch_integration/data/uploads/detect_c4fbff0fa4.jpg
!waterwatch_integration/data/uploads/detect_dcee4937b9.jpg
!waterwatch_integration/data/uploads/detect_f713789929.jpg

# Frontend build & duplicate assets
waterwatch_integration/frontend/.next/
waterwatch_integration/frontend/hero-bg.jpg

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
