# Git ignore rules for WaterWatch AI Machine Learning Pipeline

# Raw datasets and archive files
*.zip
*.tar
*.gz
*.rar
*.7z

# Ignore large raw and extracted data
data/raw/
data/extracted/
dataset/
*.csv
!reports/*.csv
!data/processed/*_sample.csv

# Keep directory structure with .gitkeep
!.gitkeep

# Model weights and artifacts
models/rainfall/*.joblib
models/rainfall/*.json
models/rainfall/*.pkl
models/image/*.pt
models/image/*.onnx
models/image/*.engine
runs/
*.pt

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & notebooks
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
