# WaterWatch AI - Integration Environment Configuration Template
# All settings apply exclusively to the isolated waterwatch_integration/ application

# Server Configuration
INTEGRATION_PORT=8080
INTEGRATION_HOST=127.0.0.1
DEBUG=True

# Database Configuration (Defaults to isolated SQLite in integration data dir)
DATABASE_URL=sqlite:///./waterwatch_integration/data/waterwatch_integration.db
# For PostgreSQL/PostGIS in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/waterwatch_integration_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Routing Provider (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Live Weather Provider (Open-Meteo)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Security & Admin Authentication Secret (isolated integration development secret)
ADMIN_SECRET_KEY=waterwatch-nagpur-dev-admin-secret-2026
ADMIN_USERNAME=nagpur_admin
ADMIN_PASSWORD=nmc_waterwatch_secure_pass

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_DIR=./waterwatch_integration/data/uploads
